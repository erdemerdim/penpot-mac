# Kurulum betiğinin (kurulum.sh) indireceği bileşen sürümleri.
# İki Mac'in aynı sürümlerle kurulması için bu dosya depoda tutulur.
# PENPOT_VERSION'ı update.sh, Penpot güncellenince kendisi yazar.

PENPOT_VERSION=2.18.7

# DMG ile dağıtılan uygulamanın kendi sürümü (Info.plist CFBundleShortVersionString).
# GitHub Release etiketi bununla aynı olmalı: APP_VERSION=1.0.0 -> etiket v1.0.0.
# Her yeni DMG'de artırın; uygulamalar güncelleme bildirimini bu karşılaştırmayla gösterir.
APP_VERSION=1.0.0
UPDATE_REPO=erdemerdim/penpot-mac

# Java (Azul Zulu, Apple Silicon)
JDK_URL=https://cdn.azul.com/zulu/bin/zulu25.38.109-ca-jdk25.0.5.0.3-macosx_aarch64.tar.gz
JDK_SHA256=fdeec963512a67082616d86df67ee326fe9f3d564ff83b7030c3f34a225a902a

# Node.js (Sistem/node içine kurulur; Mac'te ayrıca Node kurulu olması gerekmez)
NODE_VERSION=24.22.0
NODE_SHA256=75ddfb875bbd868ebe57536f4442225f54dd10f6d2178dd439de869a5c648dc3

# PostgreSQL (kaynaktan derlenir, uuid-ossp eklentisiyle)
PG_VERSION=15.19
PG_SHA256=e1a64a87a46b825b88c082e4518161a47aab53c45694964f8ba1df28f7859f89

# Valkey (kaynaktan derlenir)
VALKEY_VERSION=8.1.11
VALKEY_SHA256=db3642dfc2fb24e42313b9e9c1557cf0160acce3bf2cd366ce654ce291133b50
