# Penpot local (Docker'sız) ayarları
# Bu bir şablondur. kurulum.sh, gizli değerleri (__...__) rastgele üreterek penpot.env dosyasını oluşturur.
# penpot.env gizli anahtar içerir ve depoya gönderilmez.
export PP_HOME="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export JAVA_HOME="$PP_HOME/jdk/Contents/Home"
export PATH="$PP_HOME/bin:$PP_HOME/node/bin:$PP_HOME/pgsql/bin:$PP_HOME/valkey/bin:$JAVA_HOME/bin:/usr/local/bin:$PATH"
export PENPOT_FLAGS="enable-registration enable-login-with-password disable-email-verification disable-secure-session-cookies enable-log-emails disable-onboarding-questions enable-mcp"
export PENPOT_PUBLIC_URI="http://localhost:9001"
export PENPOT_SECRET_KEY="__SECRET_KEY__"
export PENPOT_HTTP_SERVER_HOST="127.0.0.1"
export PENPOT_HTTP_SERVER_PORT=6060
export PENPOT_DATABASE_URI="postgresql://127.0.0.1:5432/penpot"
export PENPOT_DATABASE_USERNAME=penpot
export PENPOT_DATABASE_PASSWORD="__DB_PASSWORD__"
export PENPOT_REDIS_URI="redis://127.0.0.1:6379/0"
export PENPOT_OBJECTS_STORAGE_BACKEND=fs
export PENPOT_OBJECTS_STORAGE_FS_DIRECTORY="$PP_HOME/data/assets"
export PENPOT_TELEMETRY_ENABLED=false
export PENPOT_SMTP_DEFAULT_FROM=no-reply@example.com
export PENPOT_SMTP_DEFAULT_REPLY_TO=no-reply@example.com
export JAVA_OPTS="-Duser.language=en -Duser.country=US -Dfile.encoding=UTF-8"
# Exporter (PNG/JPG/PDF/WEBP dışa aktarma)
export PLAYWRIGHT_BROWSERS_PATH="$PP_HOME/browsers"
export PENPOT_INTERNAL_URI="http://localhost:9001"
export PENPOT_TEMPDIR="$PP_HOME/data/exporter-tmp"
